# ========================================
# AI项目管理系统 - 环境变量配置模板
# ========================================
# 复制此文件为 .env 并根据需要修改配置

# ========================================
# 项目基础配置
# ========================================
PROJECT_NAME=AI项目管理系统
PROJECT_VERSION=0.1.0
ENVIRONMENT=development

# ========================================
# 服务器配置
# ========================================
FRONTEND_PORT=3000
BACKEND_PORT=8001
API_V1_STR=/api/v1

# ========================================
# RAG服务配置
# ========================================
RAG_API_ENDPOINT=http://localhost:8002
RAG_API_KEY=
RAG_COLLECTION_NAME=project_management
RAG_TIMEOUT=30
RAG_MAX_RETRIES=3
USE_RAG_SERVICE=true

# ========================================
# Supabase配置 (数据库+认证+存储)
# ========================================
# Supabase项目URL（本地开发可以是 http://localhost:8000）
SUPABASE_URL=https://your-project-ref.supabase.co
# Anon Key - 用于客户端操作（用户登录、注册等），必需
SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_KEY 是 SUPABASE_ANON_KEY 的别名，两者设置一个即可
# SUPABASE_KEY=your-supabase-anon-key
# Service Key - 用于服务端管理操作（管理员功能），可选但推荐
SUPABASE_SERVICE_KEY=your-supabase-service-key
STORAGE_BUCKET=project-files

# ========================================
# AI模型配置 (火山引擎/豆包)
# ========================================
OPENAI_API_KEY=your-volcengine-api-key
OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/
DEFAULT_LLM_MODEL=deepseek-v3-250324
DEFAULT_EMBEDDING_MODEL=doubao-embedding-text-240715

# ========================================
# 文件上传配置
# ========================================
MAX_FILE_SIZE=104857600
ALLOWED_FILE_TYPES=pdf,docx,xlsx,pptx,txt,md,jpg,jpeg,png,gif,bmp,mp4,avi,mov,wmv,mp3,wav,flac

# ========================================
# 日志配置
# ========================================
LOG_LEVEL=INFO
LOG_DIR=./logs

# ========================================
# CORS配置
# ========================================
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ========================================
# 前端环境变量
# ========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_APP_NAME=AI项目管理系统
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001/api/v1 